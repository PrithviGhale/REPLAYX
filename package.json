{
  "name": "replayx",
  "version": "0.2.1-alpha.3",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc && vite build",
    "tauri": "tauri",
    "desktop": "tauri dev",
    "test": "cargo test --manifest-path src-tauri/Cargo.toml",
    "test:frontend": "node --experimental-strip-types --test tests/clip-events.test.ts tests/library.test.ts tests/record.test.ts",
    "test:media": "cargo run --manifest-path src-tauri/Cargo.toml --bin replayx-cli -- self-test"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.10.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "lucide-react": "^0.468.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^4.7.0",
    "typescript": "^5.9.0",
    "vite": "^6.4.0"
  }
}
